<style>
  .uf-page {
    min-height: calc(100vh - 56px);
    background: #f5f6f8;
    display: flex;
    align-items: flex-start;
    padding: 3rem 1rem 3rem;
  }
  .uf-card {
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 4px 20px rgba(0,0,0,.07);
    padding: 2.75rem 2.25rem 2.25rem;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }
  .uf-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9ca3af;
    margin-bottom: 0.3rem;
  }
  .uf-title {
    font-size: 1.65rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 2rem;
    line-height: 1.2;
  }
  .uf-card .form-floating > .form-control,
  .uf-card .form-floating > textarea.form-control {
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    background: #fafafa;
    font-size: 0.93rem;
    color: #111827;
    transition: border-color 0.18s, box-shadow 0.18s, background 0.18s;
  }
  .uf-card .form-floating > .form-control:focus,
  .uf-card .form-floating > textarea.form-control:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,.13);
    background: #fff;
    outline: none;
  }
  .uf-card .form-floating label {
    color: #9ca3af;
    font-size: 0.88rem;
  }
  .uf-card .form-floating > textarea.form-control {
    height: 96px;
    resize: none;
  }
  .uf-btn {
    background: #111827;
    color: #fff;
    border: none;
    border-radius: 9px;
    padding: 0.62rem 1.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.015em;
    cursor: pointer;
    transition: background 0.18s, transform 0.1s;
  }
  .uf-btn:hover { background: #1f2937; }
  .uf-btn:active { transform: scale(0.98); }
  .uf-signin-hint {
    font-size: 0.82rem;
    color: #9ca3af;
  }
  .uf-signin-hint a {
    color: #6366f1;
    font-weight: 600;
    text-decoration: none;
  }
  .uf-signin-hint a:hover { text-decoration: underline; }
  .uf-divider {
    border: none;
    border-top: 1px solid #f0f0f0;
    margin: 1.75rem 0 1.5rem;
  }
</style>

<div class="uf-page">
  <div class="container-fluid px-0">
    <div class="uf-card">
      <p class="uf-eyebrow"><%= locals.user_details ? 'Account' : 'Get started' %></p>
      <h1 class="uf-title"><%= locals.user_details ? 'Edit profile' : 'Create your account' %></h1>

      <div class="row g-3">
        <div class="col-12 col-sm-6">
          <div class="form-floating">
            <input type="text" class="form-control" id="name" placeholder="Full name"
              value="<%= locals.user_details ? locals.user_details.name : '' %>" required>
            <label for="name">Full name</label>
          </div>
        </div>
        <div class="col-12 col-sm-6">
          <div class="form-floating">
            <input type="date" class="form-control" id="dob" placeholder="Date of birth"
              value="<%= locals.user_details ? getFormattedDate(locals.user_details.dob) : '' %>" required>
            <label for="dob">Date of birth</label>
          </div>
        </div>
        <div class="col-12 col-sm-6">
          <div class="form-floating">
            <input type="tel" class="form-control" id="phone" placeholder="Phone number"
              value="<%= locals.user_details ? locals.user_details.phone : '' %>" required>
            <label for="phone">Phone number</label>
          </div>
        </div>
        <div class="col-12 col-sm-6">
          <div class="form-floating">
            <input type="email" class="form-control" id="email" placeholder="Email address"
              value="<%= locals.user_details ? locals.user_details.email : '' %>" required>
            <label for="email">Email address</label>
          </div>
        </div>
        <div class="col-12">
          <div class="form-floating">
            <textarea class="form-control" id="address" placeholder="Address" required><%= locals.user_details ? locals.user_details.address : '' %></textarea>
            <label for="address">Address</label>
          </div>
        </div>
      </div>

      <hr class="uf-divider">

      <div class="d-flex justify-content-between align-items-center">
        <% if (!locals.user_details) { %>
        <span class="uf-signin-hint">Already have an account? <a href="/">Sign in</a></span>
        <% } else { %>
        <span></span>
        <% } %>
        <% if (locals.user_details) { %>
        <button class="uf-btn" id="formUpdate">Save changes</button>
        <% } else { %>
        <button class="uf-btn" id="formSubmit">Create account</button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script src="/JS/Register.js"></script>
