<%- include('partials/header') %>
<%- include('partials/navbar') %>

<style>
  .blog-pg { background: #f5f6f8; padding: 2.5rem 0 4rem; }
  .article-hero {
    width: 100%; border-radius: 12px;
    aspect-ratio: 16 / 7; object-fit: cover;
    margin-bottom: 2rem; display: block;
  }
  .article-title {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 800; color: #111827;
    line-height: 1.25; margin-bottom: 1.75rem;
  }
  .article-body {
    font-size: 1rem; line-height: 1.85;
    color: #374151; white-space: pre-wrap; word-break: break-word;
  }
  /* Reactions */
  .reaction-bar {
    display: flex; align-items: center; gap: 0.6rem;
    padding-top: 1.25rem; margin-top: 1.5rem;
    border-top: 1px solid #f0f0f0;
  }
  .react-btn {
    display: inline-flex; align-items: center; gap: 0.3rem;
    border: 1.5px solid #e5e7eb; border-radius: 999px;
    padding: 0.28rem 0.85rem; font-size: 0.83rem; font-weight: 600;
    color: #6b7280; background: #fff; cursor: pointer;
    transition: border-color 0.18s, color 0.18s, background 0.18s;
    user-select: none;
  }
  .react-btn:hover { border-color: #6366f1; color: #6366f1; }
  .react-btn.selected { border-color: #6366f1; color: #6366f1; background: #eef2ff; }
  .react-btn .material-symbols-outlined { font-size: 1rem; }
  /* Comment section */
  .section-label {
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #9ca3af; margin-bottom: 1rem;
  }
  .comment-row { display: flex; gap: 0.6rem; align-items: center; margin-bottom: 0.35rem; }
  .comment-row .form-control {
    border: 1.5px solid #e5e7eb; border-radius: 9px;
    background: #fafafa; font-size: 0.9rem;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .comment-row .form-control:focus {
    border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.12);
    background: #fff; outline: none;
  }
  .comment-post-btn {
    background: #111827; color: #fff; border: none;
    border-radius: 9px; padding: 0.42rem 1.1rem;
    font-size: 0.87rem; font-weight: 600; cursor: pointer;
    transition: background 0.18s; white-space: nowrap; flex-shrink: 0;
  }
  .comment-post-btn:hover:not(:disabled) { background: #1f2937; }
  .comment-post-btn:disabled { background: #d1d5db; cursor: not-allowed; }
  .char-counter { font-size: 0.75rem; color: #9ca3af; }
  /* Comment cards */
  .comment-card {
    background: #f9fafb; border-radius: 10px;
    padding: 0.9rem 1rem; margin-bottom: 0.65rem;
  }
  .comment-author { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem; }
  .comment-avatar {
    width: 26px; height: 26px; border-radius: 50%;
    background: #e0e7ff; color: #6366f1;
    font-size: 0.68rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; text-transform: uppercase;
  }
  .comment-name { font-size: 0.85rem; font-weight: 700; color: #111827; }
  .comment-time { font-size: 0.77rem; color: #9ca3af; margin-left: auto; }
  .comment-text { font-size: 0.88rem; color: #374151; line-height: 1.6; }
  /* Sidebar */
  .blog-sidebar-sticky { position: sticky; top: 72px; }
  .blog-sidebar-inner {
    height: calc(100vh - 130px); overflow-y: auto;
    scrollbar-width: thin; scrollbar-color: #e5e7eb transparent;
  }
  @media (max-width: 991.98px) {
    .blog-sidebar-sticky { position: static; margin-top: 1.5rem; }
    .blog-sidebar-inner { height: auto; overflow-y: visible; }
  }
  .sidebar-label {
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: #9ca3af;
    padding-bottom: 0.75rem; border-bottom: 1px solid #f0f0f0; margin-bottom: 0;
  }
  .sb-card {
    display: flex; gap: 0.75rem;
    padding: 0.75rem 0; border-bottom: 1px solid #f5f6f8;
    cursor: pointer; transition: opacity 0.15s;
  }
  .sb-card:hover { opacity: 0.7; }
  .sb-thumb {
    flex-shrink: 0; width: 72px; height: 56px;
    border-radius: 7px; object-fit: cover;
    background: #f0f0f0; display: block;
  }
  .sb-card-body { min-width: 0; }
  .sb-title {
    font-size: 0.83rem; font-weight: 700; color: #111827;
    line-height: 1.35; display: -webkit-box;
    -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden; margin-bottom: 0.2rem;
  }
  .sb-time { font-size: 0.74rem; color: #9ca3af; }
  .sb-status { font-size: 0.8rem; color: #9ca3af; text-align: center; padding: 0.85rem 0; }
  @keyframes sbFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .fade-in { animation: sbFadeIn 0.25s ease forwards; }
</style>

<div class="blog-pg">
  <div class="container-fluid px-4">
    <div class="row g-4">

      <!-- Main article -->
      <div class="col-lg-8 col-12">
        <div class="bg-white rounded-3 shadow-sm p-4 p-lg-5 mb-4">
          <h1 class="article-title"><%= blog_obj.title || '' %></h1>
          <% if (blog_obj.blogImage) { %>
          <img src="/uploads/blog images/<%= blog_obj.blogImage %>" class="article-hero" alt="<%= blog_obj.title || 'Blog image' %>">
          <% } %>
          <p class="article-body"><%= blog_obj.content || '' %></p>

          <div class="reaction-bar">
            <button class="react-btn" id="likeBtnId">
              <span class="material-symbols-outlined">thumb_up</span>
              <span id="likeCount"><%= blog_obj.likes || 0 %></span>
            </button>
            <button class="react-btn" id="disLikeBtnId">
              <span class="material-symbols-outlined">thumb_down</span>
              <span id="dislikeCount"><%= blog_obj.dislikes || 0 %></span>
            </button>
          </div>
        </div>

        <!-- Comments -->
        <div class="bg-white rounded-3 shadow-sm p-4 p-lg-5">
          <p class="section-label"><%= comment_list.length %> comment<%= comment_list.length !== 1 ? 's' : '' %></p>

          <form id="commentForm" method="POST" action="/postComment?id=<%= blog_obj._id || '' %>">
            <div class="comment-row">
              <input
                id="commentInput"
                type="text"
                placeholder="Write a comment…"
                name="blog-comment"
                class="form-control form-control-sm flex-grow-1"
                maxlength="1000"
                required
                autocomplete="off"
              >
              <button id="postBtn" type="submit" class="comment-post-btn" disabled>
                <span class="btn-text">Post</span>
                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
              </button>
            </div>
            <div class="d-flex align-items-start mt-1" style="min-height:1.2rem;">
              <div id="commentError" class="text-danger" style="font-size:0.8rem;display:none;"></div>
              <div id="commentSuccess" class="text-success" style="font-size:0.8rem;display:none;"></div>
              <span class="char-counter ms-auto"><span id="charCount">0</span>/1000</span>
            </div>
          </form>

          <% if (comment_list.length > 0) { %>
          <div class="mt-4">
            <% comment_list.forEach(function(item) { %>
            <div class="comment-card">
              <div class="comment-author">
                <div class="comment-avatar"><%= getUserName(item.commentBy || '').charAt(0) || '?' %></div>
                <span class="comment-name"><%= getUserName(item.commentBy || '') %></span>
                <span class="comment-time"><%= getFormattedTime(item.commentDate || '') %></span>
              </div>
              <p class="comment-text mb-0"><%= item.comment || '' %></p>
            </div>
            <% }); %>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="col-lg-4 col-12">
        <div class="bg-white rounded-3 shadow-sm p-3 blog-sidebar-sticky">
          <p class="sidebar-label">More posts</p>
          <div id="sidebar-container" class="blog-sidebar-inner">
            <% blog_List.forEach(function(item) { %>
            <div class="sb-card" onclick="window.location.href='/blogs?id=<%= item._id %>'">
              <img src="/uploads/blog images/<%= item.blogImage || '' %>" class="sb-thumb" alt="<%= item.title || '' %>">
              <div class="sb-card-body">
                <p class="sb-title"><%= item.title || '' %></p>
                <span class="sb-time"><%= item.updatedAt ? getFormattedTime(item.updatedAt) : '' %></span>
              </div>
            </div>
            <% }); %>

            <div id="loading-indicator" style="display:none;">
              <div class="sb-status d-flex align-items-center justify-content-center gap-2">
                <div class="spinner-border spinner-border-sm" role="status"></div>Loading…
              </div>
            </div>
            <div id="end-indicator" style="display:none;">
              <p class="sb-status">You’re all caught up</p>
            </div>
            <div id="error-indicator" style="display:none;">
              <div class="sb-status">
                <span class="text-danger d-block mb-1" style="font-size:0.83rem;">Failed to load</span>
                <button class="react-btn" style="font-size:0.78rem;" onclick="retryLoading()">Retry</button>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  $(document).ready(function() {
    const commentForm = $('#commentForm');
    const commentInput = $('#commentInput');
    const postBtn = $('#postBtn');
    const charCount = $('#charCount');
    const commentError = $('#commentError');
    const commentSuccess = $('#commentSuccess');

    commentInput.on('input', function() {
      const text = $(this).val().trim();
      const length = text.length;
      charCount.text(length);
      if (length > 0 && length <= 1000) {
        postBtn.prop('disabled', false);
        commentError.hide();
      } else {
        postBtn.prop('disabled', true);
        if (length > 1000) commentError.text('Comment is too long. Maximum 1000 characters allowed.').show();
      }
      if (length > 900) charCount.addClass('text-danger').removeClass('text-warning text-muted');
      else if (length > 800) charCount.addClass('text-warning').removeClass('text-danger text-muted');
      else charCount.addClass('text-muted').removeClass('text-danger text-warning');
    });

    commentForm.on('submit', function(e) {
      e.preventDefault();
      const commentText = commentInput.val().trim();
      if (!commentText) { commentError.text('Please write a comment before posting.').show(); commentInput.focus(); return; }
      if (commentText.length > 1000) { commentError.text('Comment is too long. Maximum 1000 characters allowed.').show(); return; }
      postBtn.prop('disabled', true);
      postBtn.find('.btn-text').text('Posting...');
      postBtn.find('.spinner-border').removeClass('d-none');
      commentError.hide(); commentSuccess.hide();
      $.ajax({
        url: $(this).attr('action'), method: 'POST', data: $(this).serialize(),
        headers: { 'Accept': 'application/json' },
        success: function(response) {
          if (response.success) {
            commentSuccess.text(response.message || 'Comment posted successfully!').show();
            commentInput.val(''); charCount.text('0');
            setTimeout(() => { location.reload(); }, 1500);
          } else {
            commentError.text(response.message || 'Failed to post comment').show();
          }
        },
        error: function(xhr) {
          let errorMessage = 'An error occurred while posting your comment.';
          if (xhr.responseJSON && xhr.responseJSON.message) errorMessage = xhr.responseJSON.message;
          else if (xhr.status === 401) { errorMessage = 'Please log in to post comments.'; setTimeout(() => { window.location.href = '/login'; }, 2000); }
          else if (xhr.status === 429) errorMessage = 'You are posting too quickly. Please wait a moment.';
          commentError.text(errorMessage).show();
        },
        complete: function() {
          postBtn.find('.btn-text').text('Post');
          postBtn.find('.spinner-border').addClass('d-none');
          const text = commentInput.val().trim();
          if (text.length > 0 && text.length <= 1000) postBtn.prop('disabled', false);
        }
      });
    });

    $('#likeBtnId').on('click', function() {
      const $this = $(this);
      if ($this.hasClass('processing')) return;
      $this.addClass('processing');
      const isCurrentlySelected = $this.hasClass('selected');
      const newLikeState = !isCurrentlySelected;
      var likeCount = parseInt($('#likeCount').text()) || 0;
      fetch('/likeBlog?id=<%= blog_obj._id || "" %>', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isLiked: newLikeState })
      })
      .then(r => { if (!r.ok) throw new Error('HTTP error ' + r.status); return r.json(); })
      .then(data => {
        if (data.success) {
          $this.toggleClass('selected');
          likeCount = newLikeState ? likeCount + 1 : Math.max(0, likeCount - 1);
          $('#likeCount').text(likeCount);
          if (newLikeState && $('#disLikeBtnId').hasClass('selected')) {
            $('#disLikeBtnId').removeClass('selected');
            $('#dislikeCount').text(Math.max(0, parseInt($('#dislikeCount').text()) - 1));
          }
        } else { alert(data.message || 'Failed to update like'); }
      })
      .catch(err => { console.error('Error:', err); alert('An error occurred. Please try again.'); })
      .finally(() => { $this.removeClass('processing'); });
    });

    $('#disLikeBtnId').on('click', function() {
      const $this = $(this);
      if ($this.hasClass('processing')) return;
      $this.addClass('processing');
      const isCurrentlySelected = $this.hasClass('selected');
      const newDislikeState = !isCurrentlySelected;
      var dislikeCount = parseInt($('#dislikeCount').text()) || 0;
      fetch('/dislikeBlog?id=<%= blog_obj._id || "" %>', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isDisliked: newDislikeState })
      })
      .then(r => { if (!r.ok) throw new Error('HTTP error ' + r.status); return r.json(); })
      .then(data => {
        if (data.success) {
          $this.toggleClass('selected');
          dislikeCount = newDislikeState ? dislikeCount + 1 : Math.max(0, dislikeCount - 1);
          $('#dislikeCount').text(dislikeCount);
          if (newDislikeState && $('#likeBtnId').hasClass('selected')) {
            $('#likeBtnId').removeClass('selected');
            $('#likeCount').text(Math.max(0, parseInt($('#likeCount').text()) - 1));
          }
        } else { alert(data.message || 'Failed to update dislike'); }
      })
      .catch(err => { console.error('Error:', err); alert('An error occurred. Please try again.'); })
      .finally(() => { $this.removeClass('processing'); });
    });
  });

  let currentPage = 2;
  let isLoading = false;
  let hasMoreContent = true;
  const sidebarContainer = document.getElementById('sidebar-container');
  const loadingIndicator = document.getElementById('loading-indicator');
  const endIndicator = document.getElementById('end-indicator');
  const errorIndicator = document.getElementById('error-indicator');

  window.retryLoading = function() { errorIndicator.style.display = 'none'; loadMoreBlogs(); };

  async function loadMoreBlogs() {
    if (isLoading || !hasMoreContent) return;
    isLoading = true;
    loadingIndicator.style.display = 'block';
    errorIndicator.style.display = 'none';
    try {
      const response = await fetch(`/blogs/api/more-blogs?currentBlogId=<%= blog_obj._id || '' %>&page=${currentPage}&limit=5`);
      if (!response.ok) throw new Error('HTTP error ' + response.status);
      const data = await response.json();
      if (data.html && data.html.trim()) {
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = data.html;
        tempDiv.querySelectorAll('.sb-card').forEach(card => card.classList.add('fade-in'));
        while (tempDiv.firstChild) sidebarContainer.insertBefore(tempDiv.firstChild, loadingIndicator);
        currentPage++;
        hasMoreContent = data.hasMore;
        if (!hasMoreContent) endIndicator.style.display = 'block';
      } else {
        hasMoreContent = false;
        endIndicator.style.display = 'block';
      }
    } catch (err) {
      console.error('Error loading more blogs:', err);
      errorIndicator.style.display = 'block';
    } finally {
      isLoading = false;
      loadingIndicator.style.display = 'none';
    }
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting && hasMoreContent && !isLoading) loadMoreBlogs(); });
  }, { root: sidebarContainer, rootMargin: '200px', threshold: 0.1 });
  observer.observe(loadingIndicator);

  let scrollTimeout;
  sidebarContainer.addEventListener('scroll', () => {
    if (scrollTimeout) clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(() => {
      if (hasMoreContent && !isLoading) {
        const { scrollHeight, scrollTop, clientHeight } = sidebarContainer;
        if (scrollTop + clientHeight >= scrollHeight - 150) loadMoreBlogs();
      }
    }, 100);
  });
  sidebarContainer.setAttribute('tabindex', '0');
  sidebarContainer.addEventListener('keydown', (e) => {
    if (e.key === 'Space' && hasMoreContent && !isLoading) { e.preventDefault(); loadMoreBlogs(); }
  });
</script>

<%- include('partials/footer') %>
