<%- include('partials/header') %>
<%- include('partials/navbar') %>

<style>
  .dash-page {
    background: #f5f6f8;
    min-height: calc(100vh - 57px);
    padding: 2rem 0 3rem;
  }
  .dash-empty {
    text-align: center;
    padding: 5rem 1rem;
    color: #9ca3af;
  }
  .dash-empty .material-symbols-outlined {
    font-size: 2.75rem;
    display: block;
    margin-bottom: 0.75rem;
    color: #d1d5db;
  }
  .dash-empty p { font-size: 0.92rem; margin: 0; }
  .blog-card {
    background: #fff;
    border: none;
    border-radius: 12px;
    box-shadow: 0 1px 3px rgba(0,0,0,.05), 0 2px 12px rgba(0,0,0,.06);
    cursor: pointer;
    transition: transform 0.18s, box-shadow 0.18s;
    overflow: hidden;
  }
  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 24px rgba(0,0,0,.11);
  }
  .blog-card .card-img-top {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .blog-card .card-body { padding: 1rem 1.1rem 1.2rem; }
  .blog-card .card-title {
    font-size: 0.97rem;
    font-weight: 700;
    color: #111827;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0.4rem;
  }
  .blog-card .card-text {
    font-size: 0.83rem;
    color: #6b7280;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0;
  }
  /* Modal */
  .bh-modal .modal-content {
    border: none;
    border-radius: 14px;
    box-shadow: 0 8px 40px rgba(0,0,0,.13);
  }
  .bh-modal .modal-header {
    border-bottom: 1px solid #f0f0f0;
    padding: 1.25rem 1.5rem 1rem;
  }
  .bh-modal .modal-title { font-size: 1rem; font-weight: 700; color: #111827; }
  .bh-modal .modal-body { padding: 1.25rem 1.5rem; }
  .bh-modal .modal-footer {
    border-top: 1px solid #f0f0f0;
    padding: 0.9rem 1.5rem;
    gap: 0.5rem;
  }
  .bh-modal .form-floating > .form-control,
  .bh-modal .form-floating > textarea.form-control {
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    background: #fafafa;
    font-size: 0.93rem;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .bh-modal .form-floating > .form-control:focus,
  .bh-modal .form-floating > textarea.form-control:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,.12);
    background: #fff;
    outline: none;
  }
  .bh-modal .form-floating label { color: #9ca3af; font-size: 0.88rem; }
  .bh-modal .form-floating > textarea.form-control { height: 120px; resize: none; }
  .bh-modal .bh-file-label {
    font-size: 0.82rem;
    color: #6b7280;
    margin-bottom: 0.35rem;
    display: block;
  }
  .bh-modal .bh-file-input {
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    font-size: 0.88rem;
    background: #fafafa;
  }
  .bh-btn-cancel {
    background: #f3f4f6;
    color: #374151;
    border: none;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 0.87rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s;
  }
  .bh-btn-cancel:hover { background: #e5e7eb; }
  .bh-btn-publish {
    background: #111827;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.5rem 1.25rem;
    font-size: 0.87rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.18s;
  }
  .bh-btn-publish:hover { background: #1f2937; }
</style>

<div class="dash-page">
  <div class="container-fluid px-4">
    <% if (blog_list && blog_list.length > 0) { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
      <% blog_list.forEach(function(item) { %>
      <div class="col">
        <div class="blog-card card h-100" uid="<%= item._id %>">
          <img src="/uploads/blog images/<%= item.blogImage || '' %>" class="card-img-top" alt="<%= item.title || 'Blog image' %>">
          <div class="card-body">
            <h5 class="card-title"><%= item.title || '' %></h5>
            <p class="card-text"><%= item.content || '' %></p>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div class="dash-empty">
      <span class="material-symbols-outlined">article</span>
      <p>No posts yet &mdash; hit <strong>Write</strong> to publish your first one.</p>
    </div>
    <% } %>
  </div>
</div>

<!-- Blog Create Modal -->
<div class="modal fade bh-modal" id="blogModal" tabindex="-1" aria-labelledby="blogModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="blogModalLabel">New post</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/blog-create" method="post" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="d-flex flex-column gap-3">
            <div class="form-floating">
              <input type="text" class="form-control" id="blog-title" name="title" placeholder="Title">
              <label for="blog-title">Title</label>
            </div>
            <div class="form-floating">
              <textarea class="form-control" id="blog-content" name="content" placeholder="Write something…"></textarea>
              <label for="blog-content">Write something…</label>
            </div>
            <div>
              <label class="bh-file-label" for="blog-img-upload-text">Cover image <span style="color:#d1d5db">(optional)</span></label>
              <input type="file" class="form-control bh-file-input" id="blog-img-upload-text" name="blogImage">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="bh-btn-cancel" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="bh-btn-publish" id="blog-img-upload">Publish</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    $(document).on('click', '.card[uid]', function () {
      window.location.replace('/blogs?id=' + $(this).attr('uid'));
    });
  });
</script>

<%- include('partials/footer') %>
